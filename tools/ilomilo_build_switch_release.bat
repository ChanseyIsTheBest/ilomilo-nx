@echo off
rem ilomilo-nx (2026-11-25): the distributable NRO (the request's step 8) WITHOUT PGO and LTO (those wait for the
rem user's word: tools\build_switch_release.bat is the base's PGO + LTO one). Its own folder, app\out\switch-release,
rem configured with the everyday Switch build's own options (taken from app\out\switch\CMakeCache.txt on 2026-11-25)
rem but BANJO_RENUT_RELEASE_SHADERS=ON: no game shader in the NRO (deko3d_glsl.bin beside it, which the web installer
rem makes from the player's files; run tools\renut_release_shaders.py first). The machine copies in place, no guard
rem forms. Output: app\out\switch-release\renut.nro, the log in out\<log name>.
rem   tools\ilomilo_build_switch_release.bat [log name]
setlocal
cd /d "%~dp0.."
set "BUILD_DIR=%~dp0..\app\out\switch-release"
set "GUARD_FORMS=OFF"
set "IN_PLACE=ON"
set "CMAKE_EXTRA=-DBANJO_GENERATED_MATH_FLAGS=ON -DBANJO_GENERATED_NO_TRAPPING_MATH=OFF -DBANJO_GEN_BACK_CHAIN_ELIDE=OFF -DBANJO_GEN_COLD_TRAPS=ON -DBANJO_GEN_DCBT_PREFETCH=ON -DBANJO_GEN_DEAD_DEFS=ON -DBANJO_GEN_DEAD_DEFS_POISON=OFF -DBANJO_GEN_FLOAT_LOADS=ON -DBANJO_GEN_FLUSH_HOIST=ON -DBANJO_GEN_FP_SIGN_OPS=ON -DBANJO_GEN_HOT_LAYOUT=ON -DBANJO_GEN_INLINE_LEAVES=ON -DBANJO_GEN_INLINE_MEMCALLS=ON -DBANJO_GEN_LEAF_DEAD=ON -DBANJO_GEN_LEAF_DEAD_POISON=OFF -DBANJO_GEN_LEAF_LOCALS=ON -DBANJO_GEN_LOOP_LOCALS=ON -DBANJO_GEN_LR_MOVES_ELIDE=OFF -DBANJO_GEN_LR_WRITE_SAME=ON -DBANJO_GEN_NARROW_LOOP_BARRIER=ON -DBANJO_GEN_NV_SAVES_ELIDE=OFF -DBANJO_GEN_PROMOTED_CALLS=ON -DBANJO_GEN_R1_LOCAL=ON -DBANJO_GEN_RO_CFG=ON -DBANJO_GEN_RO_CONSTANTS=ON -DBANJO_GEN_SINGLE_FLOATS=ON -DBANJO_GEN_STORE_CARDS=ON -DBANJO_GEN_SWITCH_THREAD=ON -DBANJO_GEN_VECTOR_LOCALS_BY_VALUE=ON -DBANJO_GEN_VEC_UNALIGNED=ON -DBANJO_GEN_VPERM1=ON -DBANJO_GEN_VSEL_NEON=ON -DBANJO_HOT_LAZY_LOG10=ON -DBANJO_REGISTER_O0=ON -DBANJO_RENUT_RELEASE_SHADERS=ON -DBANJO_RENUT_RENDERER=ON -DBANJO_SWITCH_DIAG_CENSUS=OFF -DBANJO_SWITCH_EARLY_RA=OFF -DBANJO_SWITCH_FLUSH_FLOW=ON -DBANJO_SWITCH_GUEST_CAS=ON -DBANJO_SWITCH_IPA_PTA=OFF -DBANJO_SWITCH_LTO=OFF -DBANJO_SWITCH_NEON_SHUFFLES=ON -DBANJO_SWITCH_NEON_VMX_HELPERS=ON -DBANJO_SWITCH_OMIT_FRAME_POINTER=ON -DBANJO_SWITCH_OUTLINE_ATOMICS=OFF -DBANJO_SWITCH_RENDERER_LINES=OFF -DBANJO_SWITCH_RENUT_DEBUG_INFO=OFF -DBANJO_SWITCH_SDK_OBJECT_OPT=ON -DBANJO_SWITCH_SDK_OPT=ON -DBANJO_SWITCH_VEC_BYTESWAP=ON -DBLUR_CARD_VIEWS_ONLY=ON -DBLUR_FMADDS_SINGLE=ON -DBLUR_FPCR_ONE_MODE=ON -DBLUR_NEAR_EXACT=OFF -DKATAMARI_BUILTIN_CONFIG=ON -DKATAMARI_RENUT_HOOKS=ON -DRENUT_NXVIDEO=ON -DSASRT_FORCE_INLINE_HELPERS=ON -DSASRT_HOT_CARD_RUNS=ON -DSASRT_HOT_GUARD_FORMS=OFF -DSASRT_HOT_IN_PLACE=ON -DSASRT_HOT_LR_ELIDE=OFF -DSASRT_HOT_MERGED_STORES=ON -DSASRT_HOT_PREFETCH=ON -DSASRT_VMX_FAST_ESTIMATES=ON -DSASRT_VMX_FUSED_MADD=ON -DBANJO_SWITCH_INLINE_AUTO=64 -DBANJO_SWITCH_INLINE_UNIT_GROWTH=12 -DBANJO_PGO="
set "LOGNAME=%~1"
if "%LOGNAME%"=="" set "LOGNAME=build_switch_release.log"
call tools\build_switch.bat > "out\%LOGNAME%" 2>&1
set "RC=%ERRORLEVEL%"
echo build_switch_release exit %RC% >> "out\%LOGNAME%"
exit /b %RC%
